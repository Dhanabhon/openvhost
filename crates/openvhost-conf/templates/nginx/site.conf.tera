# ---------------------------------------------------------------------------
# GENERATED by OpenVHost — DO NOT EDIT. To customize this site, add files under:
#   {{ custom_site_dir }}
# ---------------------------------------------------------------------------
{{ php_upstream_block }}server {
    listen {{ listen_addr }};
    server_name {{ server_name }};
    root "{{ docroot }}";
    index index.php index.html;
    # Per-site, not the global nginx.access.log/nginx.error.log (P1
    # live-log-viewer design, spec D1): overriding these in a server block
    # replaces, rather than adds to, the http-level ones, so this site's
    # lines land ONLY here — attributable to this site, not mixed with
    # every other site's. Same named format main.conf.tera declares.
    access_log "{{ access_log }}" {{ access_log_format }};
    error_log "{{ error_log }}" warn;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # Must come BEFORE the PHP location below: nginx matches regex locations
    # in file order and takes the first match, so if this were listed after
    # the PHP location, a request like /.env.php or /.git/x.php would hit
    # the PHP location first and execute instead of being denied.
    location ~ /\. {
        deny all;
    }

{{ php_location }}
}
