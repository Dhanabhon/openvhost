# ---------------------------------------------------------------------------
# GENERATED by OpenVHost — DO NOT EDIT. Regenerated idempotently; your edits
# will be lost. To customize, add files under:
#   {{ custom_sites_dir }}
# ---------------------------------------------------------------------------
daemon off;
worker_processes 1;
pid "{{ pid_path }}";
error_log "{{ error_log }}" warn;
error_log stderr notice;

events {
    worker_connections {{ worker_connections }};
}

http {
    access_log "{{ access_log }}";
    client_max_body_size {{ client_max_body_size }};
    keepalive_timeout {{ keepalive_timeout }};
    tcp_nodelay {{ tcp_nodelay }};
    fastcgi_connect_timeout {{ fastcgi_connect_timeout }};
    fastcgi_send_timeout {{ fastcgi_send_timeout }};
    fastcgi_read_timeout {{ fastcgi_read_timeout }};
    gzip {{ gzip }};{{ gzip_extra }}
    types {
        text/html                             html htm;
        text/css                              css;
        text/xml                              xml;
        text/plain                            txt;
        application/javascript                js mjs;
        application/json                      json map;
        application/pdf                       pdf;
        application/zip                       zip;
        image/svg+xml                         svg svgz;
        image/png                             png;
        image/jpeg                            jpeg jpg;
        image/gif                             gif;
        image/webp                            webp;
        image/avif                            avif;
        image/x-icon                          ico;
        font/woff                             woff;
        font/woff2                            woff2;
        font/ttf                              ttf;
        video/mp4                             mp4;
    }
    default_type application/octet-stream;
    client_body_temp_path "{{ temp_dir }}/client_body";
    proxy_temp_path "{{ temp_dir }}/proxy";
    fastcgi_temp_path "{{ temp_dir }}/fastcgi";
    uwsgi_temp_path "{{ temp_dir }}/uwsgi";
    scgi_temp_path "{{ temp_dir }}/scgi";

    include "{{ generated_sites_glob }}";
    include "{{ custom_sites_glob }}";
}
