[mysqld]
datadir={{ datadir }}
socket={{ socket }}
pid-file={{ pid_file }}
port=3306
bind-address=127.0.0.1
skip-name-resolve
mysqlx=OFF
log-error-verbosity=2
!includedir {{ custom_confd }}

[client]
socket={{ socket }}
port=3306
