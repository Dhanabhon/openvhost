; ---------------------------------------------------------------------------
; GENERATED by OpenVHost — DO NOT EDIT. To customize this pool, add files under:
;   {{ custom_pool_dir }}
; ---------------------------------------------------------------------------
[global]
error_log = {{ error_log }}

[www]
listen = {{ socket }}
pm = ondemand
pm.max_children = 4
catch_workers_output = yes
; Stated explicitly (A6): if php-fpm's own default here ever flipped, the
; desktop app's inherited environment — which on a terminal-launched dev
; build carries whatever the user's shell exports — would be visible to
; every script this pool runs.
clear_env = yes
; Stated explicitly rather than relied on as php-fpm's own default (the same
; move this project already made for nginx's mandatory `-e`): without
; try_files $uri =404 at the nginx layer, this is what stops php-fpm from
; executing a request for a file that isn't actually a .php script.
security.limit_extensions = .php
; P1 live-log-viewer design, Task 7 live-proof finding: php-fpm is launched
; with `-n` (no php.ini — stack.rs::php_fpm_spec's real invocation), which
; leaves PHP's COMPILED-IN default for log_errors in effect (Off). Without
; this, an uncaught PHP fatal was captured in NO log at all — not this
; pool's own error_log above, and no FastCGI stderr record for nginx to log
; either — proven live at the raw FastCGI-protocol level, bypassing nginx
; entirely (crates/openvhost-core/tests/site_logs_e2e.rs is the full-stack
; version of the same proof). display_errors defaulting to Off closes the
; other half of the same gap: without it, every uncaught error is dumped
; straight into the HTTP response body — full file-system paths and a stack
; trace — visible to any client that can reach 127.0.0.1:8080, the same
; disclosure class this project already treats as a security concern for
; the phpinfo() catch-all (security audit A1).
;
; Security audit M1: log_errors stays php_admin_value — a script must not be
; able to call ini_set('log_errors', 0) to go dark, since the log viewer's
; usefulness depends on it. display_errors deliberately uses the WEAKER
; php_value form instead: php_admin_value can only be set here (or in the
; main php-fpm config) and can never be changed at runtime, so
; ini_set('display_errors', 1) — the single most common PHP debugging
; incantation — would silently return false and do nothing. The security
; value of Off comes from it being the DEFAULT a script has to deliberately
; opt out of, not from making it unoverridable: by the time a script calls
; ini_set() at all it has already executed arbitrary PHP as this user, so
; locking the directive buys nothing further and only costs debuggability.
; Do not "harmonize" this with log_errors above — they differ on purpose.
php_admin_value[log_errors] = On
php_value[display_errors] = Off
include={{ custom_pool_glob }}
